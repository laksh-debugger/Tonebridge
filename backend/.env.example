# Copy this file to ".env" (same folder) and fill in your keys.
# Never share the .env file or put it on GitHub.

# AI language model (Claude). Does the translation and picks the emotion.
# Get a key at https://console.anthropic.com  (you need a few dollars of credit).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. A small, cheap one is fine.
# LLM_MODEL=claude-haiku-5-5

# Premium voice (optional). Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Optional: a different voice. Copy a Voice ID from your ElevenLabs "Voices" page.
# ELEVENLABS_VOICE_ID=
